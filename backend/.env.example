LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxx
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.8
LLM_REQUEST_TIMEOUT=60.0

DATABASE_URL=sqlite:///./app.db
CORS_ORIGINS=["http://localhost:5173"]
MAX_UPLOAD_MB=10
KNOWLEDGE_STORAGE_DIR=storage/knowledge_uploads

# 图片生成配置
# 留空时 IMAGE_API_KEY 会复用 LLM_API_KEY
IMAGE_API_KEY=
IMAGE_API_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL=dall-e-3
IMAGE_STORAGE_DIR=storage/images
IMAGE_GENERATION_ENABLED=false

# REQUIRED: 生成命令: python -c "import secrets; print(secrets.token_urlsafe(32))"
# 必须至少32字符，不能使用占位符
JWT_SECRET_KEY=your-very-secure-random-secret-key-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
